{
    "server": {
      "baseDir": "./public",
      "index": "index.html"
    },
    "open": false,
    "files": ["index.html", "manager.html", "purchase.html", "styles.css", "calendar.js", "manager.js", "purchase.js", "purchase.js"],
    "ghostMode": false,
    "notify": false,
    "snippetOptions": {
      "rule": {
        "match": "^$"
      }
    },
    "logLevel": "silent",
    "socket": {
      "domain": "localhost:3000",
      "clients": {
        "heartbeatTimeout": 60000
      }
    }
}
  